# Leave DATABASE_URL unset to use the local embedded database.
# Set it to a standard PostgreSQL URL for online or private hosting.
DATABASE_URL=
PORT=3001
BUSINESS_TIMEZONE=Pacific/Honolulu
# Set before first launch to replace demo credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=Customer123!
